/**
 * SMS Bot by RegisterMySite
 * https://registermysite.com
 *
 * After `wrangler d1 create sms-bot-registermysite`, paste the
 * database_id below. Secrets are set with `wrangler secret put`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sms-bot-registermysite",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sms-bot-registermysite",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION",
        "class_name": "ConversationDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConversationDO"]
    }
  ],
  "vars": {
    "APP_NAME": "SMS Bot",
    "APP_BRAND": "registermysite.com",
    // Public origin used to build Twilio status callbacks and OAuth redirects.
    // Override per-env if the Worker is on a custom domain.
    "PUBLIC_BASE_URL": "https://sms-bot-registermysite.YOUR_SUBDOMAIN.workers.dev"
  }
}
