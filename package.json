{
  "name": "sms-bot-registermysite",
  "version": "1.0.0",
  "private": true,
  "description": "SMS Bot by RegisterMySite — Twilio SMS dashboard with Workers AI auto-replies on Cloudflare.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create sms-bot-registermysite",
    "db:migrate:local": "wrangler d1 execute sms-bot-registermysite --local --file=./schema.sql",
    "db:migrate": "wrangler d1 execute sms-bot-registermysite --remote --file=./schema.sql",
    "tail": "wrangler tail",
    "types": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.8.3",
    "wrangler": "^4.20.0"
  }
}
